# Required for the contact form (/contact, src/app/api/contact/route.ts) to
# actually deliver mail. Get an API key at https://resend.com — set both of
# these in Vercel Project Settings -> Environment Variables, and (optionally)
# in a local .env.local for testing.

RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Admin message inbox (/admin) — requires a Postgres database and a Google
# OAuth app, both set up in Vercel Project Settings -> Environment Variables.
#
# 1. Vercel dashboard -> Storage -> Create Database -> Postgres. Connecting
#    it to this project auto-adds POSTGRES_URL and related vars — nothing to
#    copy here manually.
# 2. Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth
#    client ID (type: Web application). Authorized redirect URI:
#    https://<your-domain>/api/auth/callback/google
#    (and http://localhost:3000/api/auth/callback/google for local testing).
# 3. AUTH_SECRET: any long random string — generate one with
#    `openssl rand -base64 33` or https://generate-secret.vercel.app/33
# 4. ADMIN_EMAILS: comma-separated list of the exact Google account emails
#    allowed to sign in to /admin. Anyone else is rejected at sign-in.

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=
